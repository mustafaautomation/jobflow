# Every variable is optional. With none of them set, Jobflow runs in mock mode:
# in-memory Cedar HVAC data, mocked Stripe Checkout, mocked email/SMS, OpenStreetMap tiles,
# and a local job summary. Do not commit real values. Copy this file to .env.local.

# Mock session cookies are signed with this. Set a long random value before any real tenant data.
AUTH_SECRET=

# Supabase Auth, Postgres, and Storage. Use the publishable key in the browser path.
# Legacy anon key is accepted if the publishable key is unset.
# The secret key stays on the server. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode. Without the secret key, checkout is a local mock page.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# Optional map tiles. Without this, the map uses OpenStreetMap.
NEXT_PUBLIC_MAPTILER_KEY=

# Optional job summaries. The first key that is set is used. Otherwise the summary is drafted locally.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Used only by scripts/seed-supabase.mjs when you want real auth users.
SEED_USER_PASSWORD=

# Public origin for Stripe return URLs. The request host is used when this is unset.
NEXT_PUBLIC_APP_URL=
